# LLM providers (add keys as needed per experiment)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tavily — web search / extract / crawl / map tools
# https://app.tavily.com (free tier available)
TAVILY_API_KEY=

# Chat model — must support tool calling. Any OpenRouter slug.
CHAT_MODEL=deepseek/deepseek-v4-flash-0731

# Image model — any OpenRouter slug whose output modality is image.
# Browse: https://openrouter.ai/models?output_modalities=image
IMAGE_MODEL=bytedance-seed/seedream-4.5
# Leave blank to reuse OPENAI_API_KEY. Set both to point image generation at another account.
IMAGE_API_KEY=
IMAGE_API_HOST=https://openrouter.ai/api/v1
# 1:1 2:3 3:2 3:4 4:3 4:5 5:4 9:16 16:9 auto — infographics read top to bottom
IMAGE_ASPECT_RATIO=9:16
# 512 | 1K | 2K | 4K — below 2K the small labels come back unreadable
IMAGE_RESOLUTION=2K
# png | jpeg | webp
IMAGE_OUTPUT_FORMAT=png
# Optional palette override, e.g. for brand colours. Leave empty and the model picks
# a vivid palette to suit each subject, which is what keeps posters from looking templated.
IMAGE_PALETTE=
# A 2K render routinely outlasts a chat completion
IMAGE_REQUEST_TIMEOUT_MS=180000
# Git-ignored output folder. Keep in sync with .gitignore if you change it.
IMAGE_OUTPUT_DIR=generated-images

# Language of the answer and of every label drawn on the infographic (BCP-47)
OUTPUT_LANGUAGE=pt-BR

# LangSmith — tracing & evaluation
# https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=04-langchain-image-generation
